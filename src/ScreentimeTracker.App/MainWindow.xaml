<ui:FluentWindow x:Class="ScreentimeTracker.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:ScreentimeTracker.App.Pages"
                 Title="Screentime Tracker" Width="1000" Height="700" MinWidth="760" MinHeight="540"
                 WindowStartupLocation="CenterScreen" Icon="Assets/app.ico"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Screentime Tracker">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
        <ui:NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Left" OpenPaneLength="220"
                           IsBackButtonVisible="Collapsed" IsPaneToggleVisible="False" FrameMargin="0">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Overview" Icon="{ui:SymbolIcon DataPie24}"
                                       TargetPageType="{x:Type pages:OverviewPage}" />
                <ui:NavigationViewItem Content="Timers" Icon="{ui:SymbolIcon Timer24}"
                                       TargetPageType="{x:Type pages:TimersPage}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Settings" Icon="{ui:SymbolIcon Settings24}"
                                       TargetPageType="{x:Type pages:SettingsPage}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
