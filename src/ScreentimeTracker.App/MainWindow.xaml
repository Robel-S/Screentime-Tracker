<Window x:Class="ScreentimeTracker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:ScreentimeTracker.Core;assembly=ScreentimeTracker.Core"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:local="clr-namespace:ScreentimeTracker.App"
        Title="Screentime Tracker" Height="720" Width="560"
        WindowStartupLocation="CenterScreen" Icon="Assets/app.ico">
    <Window.Resources>
        <ObjectDataProvider x:Key="Categories" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="core:Category" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="Idle after" VerticalAlignment="Center" />
            <TextBox x:Name="IdleThresholdBox" Width="48" Margin="6,0" VerticalContentAlignment="Center"
                     KeyDown="IdleThresholdBox_KeyDown" />
            <TextBlock Text="minutes without input" VerticalAlignment="Center" />
            <Button Content="Apply" Margin="8,0,0,0" Padding="10,2" Click="ApplyIdleThreshold_Click" />
            <TextBlock x:Name="IdleThresholdStatus" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="Gray" />
            <CheckBox x:Name="RunAtLoginBox" Content="Start when I sign in" Margin="24,0,0,0"
                      VerticalAlignment="Center" Click="RunAtLoginBox_Click" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock x:Name="TimerStatus" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button x:Name="CancelTimerButton" Content="Cancel Timer" Margin="12,0,0,0" Padding="10,2"
                        Click="CancelTimer_Click" />
            </StackPanel>
            <local:TimerStarter x:Name="TimerStarter" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <RadioButton x:Name="TodayOption" Content="Today" GroupName="Period" IsChecked="True"
                         Checked="Period_Checked" />
            <RadioButton x:Name="Last7DaysOption" Content="Last 7 Days" GroupName="Period" Margin="16,0,0,0"
                         Checked="Period_Checked" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="PeriodText" Text="Today" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="TotalText" FontSize="20" Margin="10,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="Productive" Foreground="Gray" />
                <TextBlock x:Name="ProductiveText" Margin="4,0,16,0" />
                <TextBlock Text="Entertainment" Foreground="Gray" />
                <TextBlock x:Name="EntertainmentText" Margin="4,0,16,0" />
                <TextBlock Text="Uncategorized" Foreground="Gray" />
                <TextBlock x:Name="UncategorizedText" Margin="4,0,0,0" />
            </StackPanel>
        </StackPanel>
        <ListView x:Name="DayList" DockPanel.Dock="Top" Margin="0,0,0,8" Visibility="Collapsed">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Day" Width="110" DisplayMemberBinding="{Binding Day}" />
                    <GridViewColumn Header="Screen Time" Width="90" DisplayMemberBinding="{Binding Total}" />
                    <GridViewColumn Header="Productive" Width="90" DisplayMemberBinding="{Binding Productive}" />
                    <GridViewColumn Header="Entertainment" Width="95" DisplayMemberBinding="{Binding Entertainment}" />
                    <GridViewColumn Header="Uncategorized" Width="95" DisplayMemberBinding="{Binding Uncategorized}" />
                </GridView>
            </ListView.View>
        </ListView>
        <ListView x:Name="SourceList">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="App or Website" Width="220" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="Time" Width="90" DisplayMemberBinding="{Binding Time}" />
                    <GridViewColumn Header="Category" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox Width="130" ItemsSource="{Binding Source={StaticResource Categories}}"
                                          SelectedItem="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          DropDownOpened="CategoryDropDown_Opened" DropDownClosed="CategoryDropDown_Closed" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
