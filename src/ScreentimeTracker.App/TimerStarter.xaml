<UserControl x:Class="ScreentimeTracker.App.TimerStarter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="Label" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="LabelBox" Width="200" VerticalContentAlignment="Center" KeyDown="TypedBox_KeyDown"
                     ToolTip="Optional. Without one, the Timer goes by its duration." />
            <TextBlock Text="(optional)" Foreground="Gray" Margin="6,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <StackPanel x:Name="PresetButtons" Orientation="Horizontal" Margin="0,0,8,0" />
            <TextBox x:Name="MinutesBox" Width="48" VerticalContentAlignment="Center" KeyDown="TypedBox_KeyDown" />
            <TextBlock Text="minutes" Margin="6,0" VerticalAlignment="Center" />
            <Button Content="Start" Padding="10,2" Click="Start_Click" />
        </StackPanel>
        <TextBlock x:Name="ErrorText" Foreground="Firebrick" Margin="0,4,0,0" Visibility="Collapsed" />
    </StackPanel>
</UserControl>
