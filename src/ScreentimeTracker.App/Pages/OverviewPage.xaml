<Page x:Class="ScreentimeTracker.App.Pages.OverviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:core="clr-namespace:ScreentimeTracker.Core;assembly=ScreentimeTracker.Core"
      xmlns:sys="clr-namespace:System;assembly=System.Runtime"
      xmlns:charts="clr-namespace:ScreentimeTracker.App.Charts"
      Title="Overview"
      ScrollViewer.CanContentScroll="False"><!-- Fill the window; only the Source list scrolls. -->
    <Page.Resources>
        <ObjectDataProvider x:Key="Categories" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="core:Category" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- A Category with its colour, as the Category picker lists it. -->
        <DataTemplate x:Key="CategoryItem" DataType="{x:Type core:Category}">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource UncategorizedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Static core:Category.Productive}">
                                    <Setter Property="Fill" Value="{DynamicResource ProductiveBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="{x:Static core:Category.Entertainment}">
                                    <Setter Property="Fill" Value="{DynamicResource EntertainmentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <!-- The Today / Last 7 Days switch: radio buttons drawn as toggle buttons. -->
        <Style x:Key="PeriodOption" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="GroupName" Value="Period" />
        </Style>
    </Page.Resources>

    <Grid Margin="36,20,36,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="6*" MinHeight="260" />
            <RowDefinition Height="5*" MinHeight="180" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,20" LastChildFill="False">
            <TextBlock Style="{StaticResource PageTitle}" DockPanel.Dock="Left" Text="Overview" VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="TodayOption" Content="Today" IsChecked="True" Style="{StaticResource PeriodOption}"
                             Margin="0,0,6,0" Checked="Period_Checked" />
                <RadioButton x:Name="Last7DaysOption" Content="Last 7 Days" Style="{StaticResource PeriodOption}"
                             Checked="Period_Checked" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
            <Grid>
                <!-- Today: the donut, with its legend beside it. -->
                <Grid x:Name="TodayPanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <charts:DonutChart x:Name="Donut" Grid.Column="0" Margin="0,0,24,0" />
                    <StackPanel x:Name="TodayLegend" Grid.Column="1" VerticalAlignment="Center" />
                </Grid>

                <!-- Last 7 Days: the legend above the stacked columns. -->
                <DockPanel x:Name="WeekPanel" Visibility="Collapsed">
                    <WrapPanel x:Name="WeekLegend" DockPanel.Dock="Top" Margin="0,0,0,16" />
                    <charts:WeekChart x:Name="Week" />
                </DockPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="24,16,24,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource StrongText}" Grid.Column="0" Text="App or Website" />
                    <TextBlock Style="{StaticResource StrongText}" Grid.Column="1" Text="Time" HorizontalAlignment="Right" Margin="0,0,24,0" />
                    <TextBlock Style="{StaticResource StrongText}" Grid.Column="2" Text="Category" />
                </Grid>
                <TextBlock Style="{StaticResource SecondaryText}" x:Name="NoSourcesText" DockPanel.Dock="Top" Margin="24,8,24,16"
                              Text="No Screen Time yet." Visibility="Collapsed" />
                <ItemsControl x:Name="SourceList" VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer Padding="0,0,0,8" Focusable="False">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                    Padding="24,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="14" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Time}" FontSize="14" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" Margin="0,0,24,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ComboBox Grid.Column="2" MinWidth="180" HorizontalAlignment="Left"
                                              ItemsSource="{Binding Source={StaticResource Categories}}"
                                              ItemTemplate="{StaticResource CategoryItem}"
                                              SelectedItem="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              DropDownOpened="CategoryDropDown_Opened" DropDownClosed="CategoryDropDown_Closed" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>
    </Grid>
</Page>
