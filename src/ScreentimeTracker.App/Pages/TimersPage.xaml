<Page x:Class="ScreentimeTracker.App.Pages.TimersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:app="clr-namespace:ScreentimeTracker.App"
      Title="Timers"
      ScrollViewer.CanContentScroll="False"><!-- Fill the window; only the Timer list scrolls. -->
    <DockPanel Margin="36,20,36,28">
        <TextBlock Style="{StaticResource PageTitle}" DockPanel.Dock="Top" Text="Timers" Margin="0,0,0,20" />

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="Start a Timer" Margin="0,0,0,12" />
                <app:TimerStarter x:Name="Starter" />
            </StackPanel>
        </Border>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="False">
            <TextBlock Style="{StaticResource SectionTitle}" DockPanel.Dock="Left" Text="Running" VerticalAlignment="Center" />
            <ui:Button x:Name="CancelAllButton" DockPanel.Dock="Right" Content="Cancel all Timers"
                       Icon="{ui:SymbolIcon Dismiss24}" Click="CancelAll_Click" />
        </DockPanel>
        <TextBlock x:Name="NoTimersText" DockPanel.Dock="Top" Style="{StaticResource BodyText}" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="TimerList" />
        </ScrollViewer>
    </DockPanel>
</Page>
