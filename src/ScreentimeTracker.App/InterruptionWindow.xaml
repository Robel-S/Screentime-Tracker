<Window x:Class="ScreentimeTracker.App.InterruptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScreentimeTracker.App"
        Title="Time's up" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="True" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24">
        <TextBlock Text="Time's up" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,20">
            <Button x:Name="SnoozeButton" Padding="16,6" Margin="0,0,8,0" Click="Snooze_Click" />
            <Button Content="Dismiss" Padding="16,6" Click="Dismiss_Click" />
        </StackPanel>
        <TextBlock Text="Start another Timer" Foreground="Gray" Margin="0,0,0,4" />
        <local:TimerStarter x:Name="Starter" />
    </StackPanel>
</Window>
