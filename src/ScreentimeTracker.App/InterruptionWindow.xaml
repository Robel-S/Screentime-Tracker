<ui:FluentWindow x:Class="ScreentimeTracker.App.InterruptionWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:ScreentimeTracker.App"
                 Title="Time's up" Width="480" SizeToContent="Height" ResizeMode="NoResize"
                 Topmost="True" ShowInTaskbar="True" WindowStartupLocation="CenterScreen" Icon="Assets/app.ico"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round">
    <StackPanel>
        <!-- No close button: the Interruption stays until every Timer is Snoozed or Dismissed. -->
        <ui:TitleBar Title="Screentime Tracker" ShowMaximize="False" ShowClose="False" CanMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
        <StackPanel Margin="28,8,28,28">
            <TextBlock Text="Time's up" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Margin="0,0,0,20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <StackPanel x:Name="RingingList" />
            <ui:TextBlock Text="New Timer" FontTypography="BodyStrong" Margin="0,16,0,10" />
            <local:TimerStarter x:Name="Starter" />
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
